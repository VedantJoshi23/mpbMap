{
 "version": 8,
 "name": "tactical-grid",
 "metadata": {
  "kairos:codename": "tactical-grid",
  "kairos:note": "Original Kairos skin. No boundary layer by design (CONST-CORE Law 12)."
 },
 "sources": {
  "openmaptiles": {
   "type": "vector",
   "url": "https://tiles.openfreemap.org/planet",
   "attribution": "<a href=\"https://openfreemap.org\">OpenFreeMap</a> <a href=\"https://www.openmaptiles.org/\">&copy; OpenMapTiles</a> Data from <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>"
  }
 },
 "glyphs": "asset://glyphs/{fontstack}/{range}.pbf",
 "layers": [
  {
   "id": "background",
   "type": "background",
   "paint": {
    "background-color": "#C8C2A3"
   }
  },
  {
   "id": "wood",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landcover",
   "paint": {
    "fill-color": "#8E9468",
    "fill-opacity": 0.8
   },
   "filter": [
    "==",
    [
     "get",
     "class"
    ],
    "wood"
   ]
  },
  {
   "id": "grass",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landcover",
   "paint": {
    "fill-color": "#B8B48A",
    "fill-opacity": 0.6
   },
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "grass",
      "farmland"
     ]
    ]
   ]
  },
  {
   "id": "water",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "water",
   "paint": {
    "fill-color": "#6E8C99",
    "fill-opacity": 1.0
   }
  },
  {
   "id": "road-minor",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "minor",
      "service",
      "track"
     ]
    ]
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#E4DEC4",
    "line-width": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     12,
     0.5,
     16,
     3
    ]
   },
   "minzoom": 12
  },
  {
   "id": "road-major",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
